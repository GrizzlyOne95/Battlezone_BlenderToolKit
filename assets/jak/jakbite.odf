// DRAFT (UNQUALIFIED) -- invisible dummy sniper: animation-state trigger.
// Cloned from stock g2snipe.odf (classLabel = "snipergun").
// Purpose: drive the native Person sniper/crouch FSM
// (stand2Kneel -> fireRecoilSniper -> kneel2stand = attack1 -> attack2 ->
// attack3). NOT a damage weapon: ordName points at the neutered
// jakbitb. No muzzle flash, no gunshot sound.

[WeaponClass]
classLabel = "snipergun"
ordName = "jakbitb"
wpnName = "Jak Bite Trigger"
wpnReticle = "gblstbz2"
wpnPriority = 0
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.5
